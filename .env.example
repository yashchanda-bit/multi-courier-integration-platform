# Application
NODE_ENV=development
PORT=3000

# Local Docker Compose defaults only; use managed secrets outside development.
POSTGRES_DB=courier_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courier_platform?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MockCourier is for local development and automated tests only.
ENABLE_MOCK_COURIER=true

# UrbaneBolt values are intentionally blank.
URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_USERNAME=
URBANEBOLT_PASSWORD=
URBANEBOLT_TIMEOUT_MS=5000
URBANEBOLT_RETRY_MAX_ATTEMPTS=3
URBANEBOLT_RETRY_BASE_DELAY_MS=250
